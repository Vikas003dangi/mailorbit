# ==============================================================================
# MailOrbit Root Environment Configuration (.env.example)
# DO NOT commit real secrets or credentials to source control.
# Copy this file to .env for local development.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL 16)
# Local Docker development string:
DATABASE_URL=postgresql://mailorbit:mailorbit_dev_password@localhost:5432/mailorbit
# Neon cloud production example:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/mailorbit?sslmode=require

# Encryption Master Key (AES-256-GCM, 32 bytes base64 encoded)
# Used to encrypt sensitive tokens and relay secrets at rest in DB
ENCRYPTION_MASTER_KEY=k9+F2L6qW4mP0sU8yX1zB7cE3gH5jN9rT2vY4aC6eI8=

# Watchdog / Scheduler Tick Protection Secret
TICK_SECRET=dev-watchdog-tick-secret-change-in-prod

# Fake Local SMTP Configuration (Mailpit)
USE_FAKE_SMTP=true
FAKE_SMTP_HOST=localhost
FAKE_SMTP_PORT=1025

# CORS Allowed Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","https://vikas003dangi.github.io"]

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000
